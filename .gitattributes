# Store text with LF line endings so Windows and Mac checkouts match.
* text=auto eol=lf

# Windows scripts need CRLF to run reliably in cmd.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
