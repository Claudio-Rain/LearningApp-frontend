{
  "manifest_version": 3,
  "name": "Learning App",
  "version": "1.0",
  "description": "Recurrent Notifications to Study",
  "action": {
    "default_popup": "index.html",
    "default_title": "Timer"
  },
  "permissions": ["notifications", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
